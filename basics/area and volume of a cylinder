#include<stdio.h>

int main(){
    int radius, height;
    printf("enter radius of a cylinder : ");
    scanf("%d", &radius);
    printf("enter height of a cylinder : ");
    scanf("%d", &height);
    printf("the area of cylinder with radius %d is %f",radius,2*3.14*radius*(radius+height));
    printf("\nthe volume of cylinder with radius %d and height %d is %f",radius,height,3.14*radius*radius*height);
    return 0;
}
